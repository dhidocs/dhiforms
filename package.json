{
  "name": "dhiforms",
  "version": "0.1.0",
  "description": "JSON form definitions with a React wizard renderer and a drag-and-drop form designer (Mantine).",
  "license": "MIT",
  "author": "Dhidocs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhidocs/dhiforms.git"
  },
  "homepage": "https://github.com/dhidocs/dhiforms#readme",
  "bugs": "https://github.com/dhidocs/dhiforms/issues",
  "keywords": ["forms", "form-builder", "form-designer", "json-forms", "react", "mantine", "wizard"],
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist", "LICENSE", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/types/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./designer": {
      "types": "./dist/types/designer/index.d.ts",
      "import": "./dist/designer.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "dayjs": "^1.11.23",
    "lodash-es": "^4.18.1",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/dates": "^9.7.0",
    "@mantine/dropzone": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/modals": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mantine/core": { "optional": true },
    "@mantine/dates": { "optional": true },
    "@mantine/dropzone": { "optional": true },
    "@mantine/hooks": { "optional": true },
    "@mantine/modals": { "optional": true },
    "@mantine/notifications": { "optional": true },
    "@tabler/icons-react": { "optional": true },
    "@tanstack/react-query": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@mantine/core": "^9.7.0",
    "@mantine/dates": "^9.7.0",
    "@mantine/dropzone": "^9.7.0",
    "@mantine/hooks": "^9.7.0",
    "@mantine/modals": "^9.7.0",
    "@mantine/notifications": "^9.7.0",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
